{
  "name": "crew-local",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "A local, subscription-backed Codex voice manager with isolated project workers.",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "crew": "./cli.mjs",
    "ai-manager": "./cli.mjs"
  },
  "scripts": {
    "init": "node cli.mjs init",
    "doctor": "node cli.mjs doctor",
    "start": "node cli.mjs start",
    "stop": "node cli.mjs stop",
    "package": "node cli.mjs package",
    "test": "node --test tests/*.test.mjs",
    "desktop:dev": "electron .",
    "desktop:build:mac": "node scripts/desktop-build.mjs"
  },
  "devDependencies": {
    "electron": "44.9.2",
    "electron-builder": "26.15.3"
  },
  "main": "desktop/main.mjs"
}
