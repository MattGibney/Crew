{
  "name": "crew-local",
  "version": "0.17.0",
  "private": true,
  "type": "module",
  "description": "A local, subscription-backed Codex voice manager with isolated project workers.",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "crew": "./runtime/cli.mjs",
    "ai-manager": "./runtime/cli.mjs"
  },
  "scripts": {
    "pretest": "npm run build",
    "init": "node runtime/cli.mjs init",
    "doctor": "node runtime/cli.mjs doctor",
    "start": "node runtime/cli.mjs start",
    "stop": "node runtime/cli.mjs stop",
    "package": "node runtime/cli.mjs package",
    "test": "node --import tsx --test --test-concurrency=2 tests/*.test.mjs renderer/src/manager/*.test.mjs renderer/src/setup/*.test.mjs",
    "desktop:dev": "npm run build && electron .",
    "desktop:build:mac": "node scripts/desktop-build.mjs",
    "renderer:build": "vite build",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json",
    "source:manifest": "node scripts/update-source-manifest.mjs"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "electron": "44.9.2",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.60.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.22.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "main": "runtime/desktop/main.mjs",
  "dependencies": {
    "ajv": "8.20.0",
    "electron-updater": "6.8.9"
  }
}
