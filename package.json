{
  "name": "crew-local",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "description": "A local, subscription-backed Codex voice manager with isolated project workers.",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "crew": "./cli.mjs",
    "ai-manager": "./cli.mjs"
  },
  "scripts": {
    "pretest": "npm run renderer:build",
    "init": "node cli.mjs init",
    "doctor": "node cli.mjs doctor",
    "start": "node cli.mjs start",
    "stop": "node cli.mjs stop",
    "package": "node cli.mjs package",
    "test": "node --test --test-concurrency=2 tests/*.test.mjs renderer/src/manager/*.test.mjs renderer/src/setup/*.test.mjs",
    "desktop:dev": "npm run renderer:build && electron .",
    "desktop:build:mac": "node scripts/desktop-build.mjs",
    "renderer:build": "vite build"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.9.2",
    "electron-builder": "26.15.3",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.4",
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "@shadcn/react": "^0.3.1"
  },
  "main": "desktop/main.mjs",
  "dependencies": {
    "ajv": "8.20.0",
    "electron-updater": "6.8.9"
  }
}
